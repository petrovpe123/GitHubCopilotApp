---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A little home for your favorite links. Save, revisit, and organize your web finds with Mona, a simple bookmark manager that keeps your links on your device." />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const param = new URLSearchParams(window.location.search).get("scoutTheme");
        const theme =
          param === "light" || param === "dark"
            ? param
            : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style is:global>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light;
        --cp-bg: #f7f4ef;
        --cp-bg-elevated: #fcfbf8;
        --cp-surface: #ffffff;
        --cp-surface-soft: #f5f5f5;
        --cp-border: #dedede;
        --cp-border-strong: #919191;
        --cp-text: #242424;
        --cp-text-muted: #5c5c5c;
        --cp-text-soft: #6f6f6f;
        --cp-accent: #b11f4b;
        --cp-accent-hover: #9a1a41;
        --cp-accent-soft: rgba(177, 31, 75, 0.08);
        --cp-accent-fg: #ffffff;
        --cp-success: #16a34a;
        --cp-danger: #dc2626;
        --cp-warning: #f59e0b;
        --cp-link: #0078d4;
        --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
        --cp-overlay: rgba(255, 255, 255, 0.8);
        --cp-panel: rgba(255, 255, 255, 0.86);
        --cp-panel-strong: rgba(255, 255, 255, 0.96);
        --cp-sheen: rgba(255, 255, 255, 0.55);
        --cp-highlight: rgba(177, 31, 75, 0.12);
        --radius: 0.625rem;
        --font-body: "Segoe UI", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif;
        --font-head: "Segoe UI", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif;
      }
      html[data-theme="dark"] {
        color-scheme: dark;
        --cp-bg: #3d3b3a;
        --cp-bg-elevated: #343231;
        --cp-surface: #292929;
        --cp-surface-soft: #2e2e2e;
        --cp-border: #474747;
        --cp-border-strong: #5f5f5f;
        --cp-text: #dedede;
        --cp-text-muted: #919191;
        --cp-text-soft: #b0b0b0;
        --cp-accent: #fd8ea1;
        --cp-accent-hover: #fb7b91;
        --cp-accent-soft: rgba(253, 142, 161, 0.14);
        --cp-accent-fg: #1a1a1a;
        --cp-success: #4ade80;
        --cp-danger: #f87171;
        --cp-warning: #fbbf24;
        --cp-link: #4da6ff;
        --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
        --cp-overlay: rgba(41, 41, 41, 0.88);
        --cp-panel: rgba(41, 41, 41, 0.72);
        --cp-panel-strong: rgba(41, 41, 41, 0.96);
        --cp-sheen: rgba(255, 255, 255, 0.04);
        --cp-highlight: rgba(253, 142, 161, 0.12);
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html { background: var(--cp-bg); color: var(--cp-text); scroll-padding-top: 2rem; }
      body {
        font-family: var(--font-body);
        line-height: 1.5;
        max-width: 76rem;
        margin: 0 auto;
        padding: 0 2.5rem;
      }
      a { color: inherit; }
      code { font-family: Consolas, "Courier New", Courier, monospace; }
      .skip-link { position: absolute; left: 1rem; top: -5rem; padding: 0.75rem; background: var(--cp-surface); z-index: 2; }
      .skip-link:focus { top: 1rem; }
      .site-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--cp-border); }
      .brand { display: flex; gap: 0.5rem; align-items: center; font-size: 1.75rem; font-weight: 750; letter-spacing: -0.08em; text-decoration: none; }
      .brand-dot { color: var(--cp-accent); margin-left: -0.5rem; }
      .brand-mark { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: var(--radius); background: var(--cp-accent); color: var(--cp-accent-fg); margin-right: 0.25rem; }
      .brand-mark svg { width: 1.5rem; height: 1.5rem; }
      nav { display: flex; align-items: center; gap: 2rem; font-size: 0.875rem; }
      nav a { text-decoration: none; }
      nav a:hover { color: var(--cp-accent); }
      .nav-button { border: 1px solid var(--cp-border-strong); border-radius: var(--radius); padding: 0.625rem 1rem; font-weight: 600; }
      .nav-button span { margin-left: 0.75rem; }
      .hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: center; padding: 5.5rem 0; }
      .eyebrow { margin: 0 0 1.25rem; color: var(--cp-accent); font-size: 0.6875rem; letter-spacing: 0.16em; font-weight: 700; }
      .eyebrow span { margin-right: 0.375rem; font-size: 1rem; }
      h1 { font-size: clamp(2.75rem, 5.5vw, 4.5rem); line-height: 1.06; letter-spacing: -0.065em; margin: 0 0 1.5rem; font-weight: 700; }
      h1 span { color: var(--cp-accent); }
      .hero-description { max-width: 27rem; color: var(--cp-text-muted); line-height: 1.8; margin: 0 0 2rem; font-size: 1rem; }
      .primary-link { display: inline-flex; align-items: center; gap: 2rem; padding: 0.875rem 1.25rem; background: var(--cp-accent); color: var(--cp-accent-fg); border-radius: var(--radius); font-weight: 600; text-decoration: none; }
      .primary-link:hover { background: var(--cp-accent-hover); }
      .hero-note { font-size: 0.75rem; color: var(--cp-text-soft); margin: 1rem 0 0; }
      .hero-art { min-width: 0; padding: 1.75rem; border: 1px solid var(--cp-border); border-radius: 16px; background: var(--cp-bg-elevated); }
      .art-topline { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.5625rem; letter-spacing: 0.12em; color: var(--cp-text-soft); margin-bottom: 2.5rem; }
      .art-topline > :last-child { font-size: 1.5rem; line-height: 1; color: var(--cp-accent); }
      .preview-card { position: relative; display: flex; align-items: center; gap: 0.875rem; padding: 1.25rem; border: 1px solid var(--cp-border); border-radius: var(--radius); background: var(--cp-surface); }
      .preview-back { transform: rotate(-5deg); margin: 0 1rem; }
      .preview-middle { transform: rotate(3deg); margin: -0.5rem 0 0; }
      .preview-front { transform: rotate(-2deg); margin: -0.25rem 0.5rem 0; border-color: var(--cp-accent); }
      .preview-icon { flex-shrink: 0; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: var(--radius); background: var(--cp-accent-soft); color: var(--cp-accent); font-size: 1.25rem; }
      .preview-card strong { display: block; font-size: 0.8125rem; font-weight: 600; }
      .preview-card div > span { display: block; margin-top: 0.25rem; font-size: 0.6875rem; color: var(--cp-text-soft); }
      .preview-card .preview-slug { font-family: Consolas, "Courier New", Courier, monospace; color: var(--cp-accent); }
      .preview-arrow { margin-left: auto; color: var(--cp-text-soft); }
      .art-caption { display: flex; align-items: center; justify-content: center; gap: 0.75rem; font-size: 0.625rem; color: var(--cp-text-soft); margin-top: 2.5rem; }
      .caption-line { width: 1.5rem; height: 1px; background: var(--cp-accent); }
      .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.5rem; }
      .section-heading .eyebrow { margin-bottom: 0.5rem; }
      h2 { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; letter-spacing: -0.04em; margin: 0; }
      .local-badge { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: var(--cp-text-muted); }
      .local-badge > span { color: var(--cp-success); font-size: 0.625rem; }
      .bookmark-panel { padding: clamp(1.25rem, 4vw, 2rem); background: var(--cp-surface); border: 1px solid var(--cp-border); border-radius: 16px; }
      .how-section { display: grid; grid-template-columns: 1.15fr 1fr 1fr 1fr; gap: 2rem; padding: 4rem 0; }
      .how-heading .eyebrow { margin-bottom: 0.75rem; }
      .how-heading h2 { font-size: 1.625rem; }
      .step-number { font-family: Consolas, "Courier New", Courier, monospace; color: var(--cp-accent); font-size: 0.75rem; }
      .feature h3 { margin: 1rem 0 0.5rem; font-size: 0.9375rem; font-weight: 600; }
      .feature p { margin: 0; font-size: 0.8125rem; line-height: 1.8; color: var(--cp-text-muted); }
      .site-footer { display: flex; align-items: center; gap: 1.25rem; border-top: 1px solid var(--cp-border); padding: 1.5rem 0; color: var(--cp-text-soft); font-size: 0.6875rem; }
      .site-footer > :last-child { margin-left: auto; }
      .footer-brand { color: var(--cp-text); font-size: 1.25rem; letter-spacing: -0.06em; font-weight: 700; }
      @media (max-width: 800px) {
        .hero { gap: 2rem; padding: 3.5rem 0; }
        .hero-art { padding: 1.25rem; }
        .preview-card { padding: 0.875rem; gap: 0.5rem; }
        .preview-icon { width: 2rem; height: 2rem; }
        .how-section { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 600px) {
        body { padding: 0 1.25rem; }
        nav { gap: 1rem; font-size: 0.75rem; }
        .nav-button { padding: 0.5rem 0.625rem; }
        .nav-button span { margin-left: 0.25rem; }
        .hero { grid-template-columns: 1fr; padding: 3rem 0; }
        .hero-art { max-width: 28rem; width: 100%; justify-self: center; }
        .section-heading { align-items: start; flex-direction: column; }
        .how-section { gap: 2rem 1.5rem; padding: 3rem 0; }
        .site-footer { flex-wrap: wrap; gap: 0.75rem; }
        .site-footer > :last-child { width: 100%; margin-left: 0; }
        #add-button { width: 100%; }
      }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: end;
        margin: 0 0 0.75rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 16rem; }
      label { font-size: 0.85rem; font-weight: 600; }
      input {
        padding: 0.75rem;
        min-width: 0;
        border: 1px solid var(--cp-border-strong);
        border-radius: var(--radius);
        font: inherit;
        background: var(--cp-bg-elevated);
        color: var(--cp-text);
      }
      input:focus-visible,
      button:focus-visible,
      a:focus-visible { outline: 2px solid var(--cp-accent); outline-offset: 3px; }
      button {
        padding: 0.75rem 1rem;
        border: 1px solid var(--cp-accent);
        border-radius: var(--radius);
        background: var(--cp-accent);
        color: var(--cp-accent-fg);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { background: var(--cp-accent-hover); }
      button:disabled { opacity: 0.6; cursor: not-allowed; }
      .hint { margin: 0 0 1.5rem; font-size: 0.8rem; color: var(--cp-text-muted); }
      #bookmark-status { font-size: 0.85rem; color: var(--cp-success); }
      #bookmark-status:empty { display: none; }
      #bookmark-status.error { color: var(--cp-danger); }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 1.5rem 0 1rem;
      }
      .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
      .clear {
        background: var(--cp-surface);
        color: var(--cp-text-muted);
        border: 1px solid var(--cp-border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover, .bookmark .copy:hover { background: var(--cp-surface-soft); border-color: var(--cp-border-strong); }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        justify-content: space-between;
        padding: 1rem;
        background: var(--cp-bg-elevated);
        border: 1px solid var(--cp-border);
        border-radius: var(--radius);
      }
      .bookmark-label { flex: 1 1 16rem; min-width: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
      .bookmark .url { color: var(--cp-link); text-underline-offset: 0.2em; }
      .bookmark .slug {
        font-family: Consolas, "Courier New", Courier, monospace;
        font-size: 0.85rem;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        background: var(--cp-accent-soft);
        color: var(--cp-accent);
      }
      .bookmark .copy {
        background: var(--cp-surface);
        color: var(--cp-text);
        border: 1px solid var(--cp-border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .empty {
        margin: 0;
        padding: 2.5rem 1rem;
        text-align: center;
        background: var(--cp-bg-elevated);
        color: var(--cp-text-muted);
        border: 1px dashed var(--cp-border-strong);
        border-radius: var(--radius);
      }

    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
