<form id="add-bookmark" onsubmit="event.preventDefault()">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      aria-describedby="url-hint bookmark-status"
      required
    />
  </div>
  <button id="add-button" type="submit" disabled>Add bookmark</button>
</form>

<p id="url-hint" class="hint">With or without https:// — save your link with a unique <code>mona-</code> slug.</p>
<p id="bookmark-status" role="status" aria-live="polite"></p>
<noscript>Enable JavaScript to save and view bookmarks on this device.</noscript>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { STORAGE_KEY, normalizeUrl, loadBookmarks, generateSlug, formatBookmark } from './bookmarks.mjs';
  import type { Bookmark } from './bookmarks.mjs';

  const form = document.querySelector<HTMLFormElement>('#add-bookmark')!;
  const input = document.querySelector<HTMLInputElement>('#url')!;
  const addButton = document.querySelector<HTMLButtonElement>('#add-button')!;
  const list = document.querySelector<HTMLUListElement>('#bookmark-list')!;
  const header = document.querySelector<HTMLDivElement>('#list-header')!;
  const empty = document.querySelector<HTMLParagraphElement>('#empty-state')!;
  const status = document.querySelector<HTMLParagraphElement>('#bookmark-status')!;
  let bookmarks: Bookmark[] = [];

  function notify(message: string, error = false) {
    status.textContent = message;
    status.classList.toggle('error', error);
  }

  function render() {
    const rows = bookmarks.map((bookmark) => {
      const row = document.createElement('li');
      row.className = 'bookmark';
      const label = document.createElement('span');
      label.className = 'bookmark-label';
      label.setAttribute('aria-label', formatBookmark(bookmark));
      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.textContent = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      label.append(link, document.createTextNode(' :: '), slug);
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy slug ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          notify(`Copied ${bookmark.slug}.`);
        } catch {
          notify('Could not copy the slug. Select it and copy it manually.', true);
        }
      });
      row.append(label, copy);
      return row;
    });
    list.replaceChildren(...rows);
    empty.hidden = bookmarks.length > 0;
    header.hidden = bookmarks.length === 0;
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    let url: string;
    let slug: string;
    try {
      url = normalizeUrl(input.value);
      slug = generateSlug(bookmarks);
    } catch (error) {
      notify(error instanceof Error ? error.message : 'Enter a valid web URL.', true);
      input.focus();
      return;
    }
    const next = [...bookmarks, { url, slug }];
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
    } catch {
      notify('Could not save the link. Browser storage may be blocked or full. Your URL has been kept; try again.', true);
      return;
    }
    bookmarks = next;
    render();
    input.value = '';
    input.focus();
    notify('Bookmark saved on this device.');
  });

  document.querySelector<HTMLButtonElement>('#clear-all')!.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks on this device?')) return;
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      notify('Could not clear bookmarks. Browser storage may be blocked; try again.', true);
      return;
    }
    bookmarks = [];
    render();
    notify('All bookmarks cleared.');
  });

  try {
    const loaded = loadBookmarks(localStorage.getItem(STORAGE_KEY));
    bookmarks = loaded.bookmarks;
    if (loaded.recovered) notify('Some saved data was unreadable or invalid and was skipped.', true);
  } catch {
    notify('Could not load bookmarks. Browser storage may be blocked. Saving will be unavailable until storage is allowed.', true);
  }
  render();
  addButton.disabled = false;
</script>
