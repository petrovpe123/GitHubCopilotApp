---
import Base from '../layouts/Base.astro';
import Bookmarks from '../components/Bookmarks.astro';
---
<Base title="Mona's Bookmark Manager App">
  <header>
    <h1>🔖 Mona's Bookmark Manager App</h1>
    <p class="tagline">A little home for your favorite links. Save a URL, get a short <code>mona-</code> label, and pick up where you left off.</p>
  </header>

  <main>
    <Bookmarks />
  </main>

  <footer>
    Your bookmarks stay on this device, saved in your browser.
  </footer>
</Base>
